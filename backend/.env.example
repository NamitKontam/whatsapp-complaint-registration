
APP_NAME=WhatsApp Complaint Registration System
APP_ENV=development

DATABASE_URL=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=

META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

MEDIA_STORAGE_DIR=storage/media
WHATSAPP_MEDIA_MAX_SIZE_BYTES=5000000
COMPLAINT_DRAFT_EXPIRY_HOURS=24
WHATSAPP_OUTBOX_MAX_ATTEMPTS=5
WHATSAPP_OUTBOX_RETRY_BASE_SECONDS=30
WHATSAPP_OUTBOX_RETRY_MAX_SECONDS=3600
WHATSAPP_OUTBOX_POLL_INTERVAL_SECONDS=5
WHATSAPP_INBOX_MAX_ATTEMPTS=5
WHATSAPP_INBOX_RETRY_BASE_SECONDS=30
WHATSAPP_INBOX_RETRY_MAX_SECONDS=3600
WHATSAPP_INBOX_POLL_INTERVAL_SECONDS=5
WHATSAPP_INBOX_LEASE_SECONDS=300

DATABASE_URL=postgresql+psycopg://complaint_app:YOUR_APP_PASSWORD@localhost:5432/complaints_db
MIGRATION_DATABASE_URL=postgresql+psycopg://complaint_migrator:YOUR_MIGRATION_PASSWORD@localhost:5432/complaints_db

# Test database
TEST_DATABASE_URL=postgresql+psycopg://complaint_app:YOUR_TEST_PASSWORD@localhost:5432/complaints_test_db
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://complaint_migrator:YOUR_TEST_MIGRATION_PASSWORD@localhost:5432/complaints_test_db